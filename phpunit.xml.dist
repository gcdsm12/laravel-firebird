<?xml version="1.0" encoding="UTF-8"?>
<!-- # ALTERADO POR CODEX: unitários por omissão; integração exige Firebird descartável. -->
<phpunit bootstrap="vendor/autoload.php" colors="true" cacheResult="false" failOnWarning="true" failOnRisky="true" failOnPhpunitDeprecation="true" defaultTestSuite="Unit">
 <testsuites>
  <testsuite name="Unit"><directory>tests/Unit</directory></testsuite>
  <testsuite name="Integration"><directory suffix="Test.php">tests</directory><exclude>tests/Unit</exclude></testsuite>
 </testsuites>
</phpunit>
